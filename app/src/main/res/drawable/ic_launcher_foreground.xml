<?xml version="1.0" encoding="utf-8"?>
<!--
  Agujero negro en blanco y negro (estilo Gargantua): halo de luz pegado al horizonte, arco de luz curvada por encima y
  el disco de acreción cruzando por delante. El horizonte (radio 18) NO se rellena: el fondo del icono ya es negro, y así
  la animación de arranque puede «abrir» el agujero y enseñar la app a través de él. Cabe en el círculo seguro (r 33).
  LogoApp (Arranque.kt) depende de ese radio 18 de 108.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Halo -->
    <path android:pathData="M21,54a33,33 0 1 0 66,0a33,33 0 1 0 -66,0z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="54" android:gradientRadius="33">
                <item android:offset="0" android:color="#00FFFFFF" />
                <item android:offset="0.53" android:color="#00FFFFFF" />
                <item android:offset="0.545" android:color="#FFFFFFFF" />
                <item android:offset="0.6" android:color="#D9FFFFFF" />
                <item android:offset="0.7" android:color="#59FFFFFF" />
                <item android:offset="0.85" android:color="#14FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Luz del disco curvada por encima del agujero -->
    <path android:pathData="M34.5,54A19.5,21 0 0 1 73.5,54" android:strokeWidth="4.5">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="0" android:startY="30" android:endX="0" android:endY="60">
                <item android:offset="0" android:color="#F2FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Disco de acreción por delante -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-11">
    <path android:pathData="M21,54a33,5.5 0 1 0 66,0a33,5.5 0 1 0 -66,0z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="21" android:startY="0" android:endX="87" android:endY="0">
                <item android:offset="0" android:color="#00FFFFFF" />
                <item android:offset="0.5" android:color="#38FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M21,54a33,1.9 0 1 0 66,0a33,1.9 0 1 0 -66,0z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="21" android:startY="0" android:endX="87" android:endY="0">
                <item android:offset="0" android:color="#00FFFFFF" />
                <item android:offset="0.2" android:color="#BFFFFFFF" />
                <item android:offset="0.42" android:color="#8CFFFFFF" />
                <item android:offset="0.62" android:color="#CCFFFFFF" />
                <item android:offset="0.8" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    </group>
</vector>
